<resources>
    <!-- Color of the UDFPS pressed view -->
    <color name="config_udfpsColor">#00ffffff</color>

    <!-- Whether to enable MediaTek-specific optical dimming for UDFPS -->
    <bool name="config_udfpsMtkGhbmDimming">true</bool>

    <!-- Doze: does the double tap sensor need a proximity check? -->
    <bool name="doze_double_tap_proximity_check">true</bool>

    <!-- Doze: does the long press sensor need a proximity check? -->
    <bool name="doze_long_press_proximity_check">true</bool>

    <!-- Whether to play turbulence noise after clicking the play button -->
    <bool name="config_turbulenceNoise">false</bool>
</resources>
