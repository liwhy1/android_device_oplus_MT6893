<resources>
    <!-- the padding on the start of the statusbar -->
    <dimen name="status_bar_padding_start">0dp</dimen>

    <!-- the padding on the end of the statusbar -->
    <dimen name="status_bar_padding_end">2dp</dimen>

    <!-- the padding on the top of the statusbar (usually 0) -->
    <dimen name="status_bar_padding_top">24px</dimen>

    <dimen name="keyguard_indication_margin_bottom">10dp</dimen>

    <!-- Microns/ums (1000 um = 1mm) per pixel for the given device. If unspecified, UI that
         relies on this value will not be sized correctly. -->
    <item name="pixel_pitch" format="float" type="dimen">63.21</item>
</resources>
